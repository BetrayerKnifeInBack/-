#include <iostream>
#include <cmath>

using namespace std;

int main() {
    float x1, y1, x2, y2, x3, y3;

    cout << "Vvedite koordinaty tochek (x y):" << endl;
    cout << "Tochka A: ";
    cin >> x1 >> y1;
    cout << "Tochka B: ";
    cin >> x2 >> y2;
    cout << "Tochka C: ";
    cin >> x3 >> y3;

    float a = sqrt(pow(x2 - x1, 2) + pow(y2 - y1, 2));
    float b = sqrt(pow(x3 - x2, 2) + pow(y3 - y2, 2));
    float c = sqrt(pow(x1 - x3, 2) + pow(y1 - y3, 2));

    float P = a + b + c;
    float p = P / 2;
    float S = sqrt(p * (p - a) * (p - b) * (p - c));

    cout << "Perimetr: " << P << endl;
    cout << "Ploshchad: " << S << endl;

    return 0;
}
